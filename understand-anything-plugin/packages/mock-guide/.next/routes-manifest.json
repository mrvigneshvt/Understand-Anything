{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/annotations/[file]",
      "regex": "^/api/annotations/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfile": "nxtPfile"
      },
      "namedRegex": "^/api/annotations/(?<nxtPfile>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/mocks/[file]",
      "regex": "^/api/mocks/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfile": "nxtPfile"
      },
      "namedRegex": "^/api/mocks/(?<nxtPfile>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/seed/[file]",
      "regex": "^/api/seed/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfile": "nxtPfile"
      },
      "namedRegex": "^/api/seed/(?<nxtPfile>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/source/[file]",
      "regex": "^/api/source/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfile": "nxtPfile"
      },
      "namedRegex": "^/api/source/(?<nxtPfile>[^/]+?)(?:/)?$"
    },
    {
      "page": "/page/[id]",
      "regex": "^/page/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/page/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}